{
  "manifest_version": 3,
  "name": "Chrome Tab Grouping Companion",
  "version": "0.1.0",
  "description": "Executes validated tab grouping plans from the local Codex plugin.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "storage", "alarms"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html"
}
