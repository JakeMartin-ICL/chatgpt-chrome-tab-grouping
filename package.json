{
  "name": "chatgpt-chrome-tab-grouping",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A local Codex plugin that safely groups Chrome tabs through supported extension APIs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/mcp/cli.js",
    "native-host": "node src/bridge/native-host.js",
    "build": "node scripts/build-plugin.mjs",
    "plugin:stage": "npm run build && node scripts/stage-plugin.mjs",
    "plugin:install": "npm run plugin:stage && node scripts/install-dev-plugin.mjs",
    "plugin:refresh": "node scripts/refresh.mjs",
    "setup": "npm install && node scripts/setup.mjs",
    "setup:mac": "npm install && npm run install:mac && npm run plugin:install",
    "setup:windows": "npm install && npm run install:windows && npm run plugin:install",
    "teardown": "node scripts/teardown.mjs",
    "teardown:mac": "npm run uninstall:mac && node scripts/remove-dev-plugin.mjs",
    "teardown:windows": "npm run uninstall:windows && node scripts/remove-dev-plugin.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:bundle": "npm run build && node scripts/smoke-shared-bundle.mjs",
    "install:mac": "bash scripts/install-macos.sh",
    "uninstall:mac": "bash scripts/uninstall-macos.sh",
    "install:windows": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "uninstall:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
