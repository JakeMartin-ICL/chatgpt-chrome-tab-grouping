#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
plugin_root="$(cd "${script_dir}/.." && pwd)"
node_path_file="${plugin_root}/.native-node-path"

if [[ -f "${node_path_file}" ]]; then
  node_bin="$(<"${node_path_file}")"
else
  node_bin="$(command -v node || true)"
fi

if [[ -z "${node_bin}" || ! -x "${node_bin}" ]]; then
  echo "Node.js runtime not found. Run npm install and npm run install:mac in the plugin directory." >&2
  exit 1
fi

if [[ -f "${plugin_root}/dist/mcp.js" ]]; then
  entrypoint="${plugin_root}/dist/mcp.js"
else
  entrypoint="${plugin_root}/src/mcp/cli.js"
fi

exec "${node_bin}" "${entrypoint}"
